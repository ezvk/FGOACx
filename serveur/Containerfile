# ARTEMiS pour FGO Arcade — adapté du Dockerfile de l amont.
#
# Deux écarts, tous deux mesurés (cf. PORTAGE.md) :
#   1. python:3.10 et non 3.9.15 — le paquet embarque un Python 3.10
#      (python310.dll), et requirements.txt épingle sqlalchemy 1.4.46.
#   2. pylibmc retiré : sous Windows la marque `platform_system != "Windows"`
#      l ignorait ; sous Linux pip le COMPILE et réclame libmemcached-dev, pour
#      rien puisque core.yaml a enable_memcached: false.
FROM docker.io/library/python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      default-libmysqlclient-dev build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements.txt
RUN grep -v "^pylibmc" requirements.txt > requirements.linux.txt \
    && echo "msgpack==1.2.1" >> requirements.linux.txt \
    && pip3 install --no-cache-dir -r requirements.linux.txt

CMD ["python3", "index.py", "--config", "config"]
